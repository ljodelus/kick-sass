# Normalize text files to LF in the repository; Git converts on checkout.
* text=auto

# Files run inside Linux containers or by POSIX shells keep LF everywhere.
*.sh          text eol=lf
mvnw          text eol=lf
Dockerfile*   text eol=lf

# Windows scripts keep CRLF.
*.cmd         text eol=crlf
*.bat         text eol=crlf

# Binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.docx binary
*.jar binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.p12 binary
